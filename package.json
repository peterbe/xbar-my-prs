{
	"name": "xbars",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --watch src/my-prs.ts",
		"build": "bun build src/my-prs.ts --target=bun --outfile out/my-prs --compile --bytecode",
		"lint": "biome check",
		"lint:fix": "biome check --write --unsafe",
		"postinstall": "bunx @biomejs/biome migrate --write",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/bun": "1.3.14",
		"husky": "^9.1.7"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@donedeal0/superdiff": "^4.2.2",
		"commander": "^15.0.0",
		"date-fns": "^4.4.0",
		"octokit": "^5.0.5"
	}
}
